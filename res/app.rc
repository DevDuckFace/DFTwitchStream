#include <windows.h>

/////////////////////////////////////////////////////////////////////////////
// Icon (shown in Explorer, the task bar and the installer)
//
// The name must be the numeric id 1: the shell shows the icon with the lowest
// id, and an undefined symbol here would be stored as a string name that
// nothing looks up. GLFW additionally searches for a resource literally named
// GLFW_ICON when it creates the window class.
/////////////////////////////////////////////////////////////////////////////
1         ICON "app.ico"
GLFW_ICON ICON "app.ico"

/////////////////////////////////////////////////////////////////////////////
// Manifest: common controls v6, per-monitor DPI, and Windows 10/11 targeting
/////////////////////////////////////////////////////////////////////////////
1 RT_MANIFEST "app.manifest"

/////////////////////////////////////////////////////////////////////////////
// Version information
/////////////////////////////////////////////////////////////////////////////
VS_VERSION_INFO VERSIONINFO
    FILEVERSION     1,0,0,0
    PRODUCTVERSION  1,0,0,0
    FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
    FILEFLAGS       0x0L
    FILEOS          VOS_NT_WINDOWS32
    FILETYPE        VFT_APP
    FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "DF"
            VALUE "FileDescription",  "DF Twitch Stream"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "DFTwitchStream"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "DFTwitchStream.exe"
            VALUE "ProductName",      "DF Twitch Stream"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
